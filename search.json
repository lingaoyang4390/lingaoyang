---
layout: null
permalink: /search.json
---
[
{% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: '%Y.%m.%d' | jsonify }},
    "category": {{ post.categories | first | default: '随笔' | jsonify }},
    "description": {{ post.description | default: post.excerpt | strip_html | normalize_whitespace | jsonify }},
    "content": {{ post.content | markdownify | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]

